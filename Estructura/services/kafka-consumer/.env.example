# ===========================================
# KAFKA CONSUMER - CONFIGURACIÓN
# ===========================================
# Este archivo es un ejemplo de configuración.
# Copia este archivo como .env y ajusta los valores según tu entorno.
#
# Instrucciones:
# 1. cp .env.example .env
# 2. Ajusta los valores si es necesario
# 3. NO subas el archivo .env a Git (ya está en .gitignore)

# -------------------------------------------
# CONFIGURACIÓN DE KAFKA
# -------------------------------------------

# Servidor(es) de Kafka (separados por comas si hay varios)
# Para Docker local usa: localhost:29092
# Para Docker network usa: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Nombre del topic de Kafka a consumir
# El generador de datos usa el topic "probando"
KAFKA_TOPIC=probando

# ID del grupo de consumidores
# Cada servicio debe tener un group.id único
# Ejemplos: hr-insights-consumer, mongo-persister-group, etc.
KAFKA_GROUP_ID=hr-insights-consumer
