# ============================================================
# VARIABLES DE ENTORNO - FASTAPI SERVICE
# ============================================================

# -------------------------------------------
# APLICACIÓN
# -------------------------------------------
APP_NAME=HR-Pro-API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# -------------------------------------------
# SERVER
# -------------------------------------------
HOST=0.0.0.0
PORT=8000

# -------------------------------------------
# KAFKA
# -------------------------------------------
# Para Docker: kafka:9092
# Para local: localhost:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_USER_TRACKER=probando
KAFKA_GROUP_ID=api-consumer-group

# Topics para diferentes tipos de datos
KAFKA_TOPIC_PERSONAL=personal-data
KAFKA_TOPIC_LOCATION=location-data
KAFKA_TOPIC_PROFESSIONAL=professional-data
KAFKA_TOPIC_BANK=bank-data
KAFKA_TOPIC_NET=net-data

# -------------------------------------------
# MONGODB
# -------------------------------------------
MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=hr_pro_db
MONGODB_COLLECTION_USERS=users

# -------------------------------------------
# POSTGRESQL
# -------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hrpro
POSTGRES_PASSWORD=hrpro123
POSTGRES_DB=hr_pro_db

# -------------------------------------------
# REDIS (Cache)
# -------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# -------------------------------------------
# SERVICIOS INTERNOS
# -------------------------------------------
# URLs de otros microservicios
DATA_PROCESSOR_URL=http://data-processor:8001
MONGO_PERSISTER_URL=http://mongo-persister:8002
SQL_PERSISTER_URL=http://sql-persister:8003

# -------------------------------------------
# SEGURIDAD
# -------------------------------------------
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------------------------------------------
# CORS
# -------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
