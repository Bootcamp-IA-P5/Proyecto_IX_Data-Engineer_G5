# ============================================================
# VARIABLES DE ENTORNO PARA TESTS DE INTEGRACIÓN
# ============================================================

# -------------------------
# KAFKA (localhost para tests locales)
# -------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
#KAFKA_TOPIC=probando
KAFKA_TOPIC=pix_messages
KAFKA_GROUP_ID=mongo-persister-group_test
KAFKA_AUTO_OFFSET_RESET=earliest

# -------------------------
# MONGODB (localhost para tests locales)
# -------------------------
MONGO_URI=mongodb://localhost:27017/
#MONGO_DB=hrpro_db
MONGO_DB=pix_test
MONGO_DATABASE=pix_test
#MONGO_DATABASE=hrpro_dbn
MONGO_COLLECTION=transactions

# -------------------------
# BATCH PROCESSING
# -------------------------
BATCH_SIZE=100

# -------------------------
# LOGGING
# -------------------------
LOG_LEVEL=INFO