# ============================================================
# VARIABLES DE ENTORNO GLOBALES - PROYECTO PIX_G5_DataEngineer
# ============================================================
# IMPORTANTE: Copiar este archivo a .env y configurar con valores reales
# El archivo .env NO debe subirse al repositorio (está en .gitignore)
# ============================================================


# ----------------------------------------------------------
# MongoDB - Credenciales y configuración global
# ----------------------------------------------------------
# Usuario administrador de MongoDB
MONGO_USERNAME=<user>

# Contraseña del usuario administrador
MONGO_PASSWORD=<passwd>

# Usuario para monitoreo y estadísticas
MONGO_USERTEST=<user_test>
MONGO_PASSWORDTEST=<passwd>

# Base de datos principal del proyecto
MONGO_DATABASE=hrpro_db

# Puerto de MongoDB (host)
MONGO_PORT=27017

# Nombre del contenedor de MongoDB (para comandos docker exec)
MONGO_CONTAINER=hrpro-mongodb

# ----------------------------------------------------------
# Mongo Viewer (Mongo Express) - Interfaz web para MongoDB
# ----------------------------------------------------------
# Puerto para acceder a la interfaz web (http://localhost:8081)
MONGO_VIEWER_PORT=8081

# ----------------------------------------------------------
# Mongo Persister - Variables de entorno
# ----------------------------------------------------------
# URI de conexión a MongoDB (dentro de Docker usar nombre del servicio 'mongo')
MONGO_URI=mongodb://<user>:<passwd>@mongo:27017/

# colección
MONGO_COLLECTION=raw_messages

# Configuración de rendimiento
MONGO_BATCH_SIZE=100

# Bootstrap servers (dentro de Docker usar nombre del servicio 'kafka')
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Group ID único para este consumidor
KAFKA_GROUP_ID=mongo-persister-group

# Política de offset reset (earliest = desde el inicio, latest = solo nuevos)
KAFKA_AUTO_OFFSET_RESET=earliest


# ----------------------------------------------------------
# SQL Persister (Supabase Postgres)
# ----------------------------------------------------------
PG_HOST=<conexion.supabase.com>
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=<postgres.user> 
PG_PASSWORD=<postgres.password>
PG_SCHEMA=public

# --- SQL persister: qué considera "persona completa" ---
AGGREGATED_REQUIRED_TYPES=personal,location,professional,bank,net

# Campo de timestamp en aggregated_data (nuestro processor lo rellena)
AGGREGATED_TS_FIELD=updated_at            # o created_at

# Estado de sincronización
STATE_COLLECTION=sql_sync_state

# Supabase requiere TLS
PG_SSLMODE=require
PG_POOL_MODE=session|transaction|direct
USE_SQLA_NULLPOOL=true

# Checkpoint en Mongo
SQL_CHECKPOINT_COLLECTION=_sql_sync_state
SQL_CHECKPOINT_RESET=0

# Tunning pool/conexión
PG_POOL_MIN=1
PG_POOL_MAX=5
PG_CONNECT_TIMEOUT=10
SQL_BATCH_SIZE=500
SLEEP_SECONDS_EMPTY=10


# Lote de inserciones/UPSERT
SQL_BATCH_SIZE=1000
# Estrategia de upsert (merge/insert-only)
SQL_UPSERT_STRATEGY=merge

SQL_POLL_SECONDS=2.0
SQL_CHECKPOINT_COLLECTION=_sql_sync_state
SQL_CHECKPOINT_RESET=0
SAVE_JSON_BACKUP=false
AGGREGATED_TS_FIELD=updated_at            # o created_at




# ----------------------------------------------------------
# Data Processor - Variables de entorno
# ----------------------------------------------------------
# Colección de destino para datos agregados
AGGREGATED_COLLECTION=aggregated_data

# Tamaño de lote para procesamiento
BATCH_SIZE=1000

# Intervalo en segundos entre cada procesamiento
PROCESSING_INTERVAL=10

# Tiempo en segundos para considerar datos completos (timeout)
GROUPING_WINDOW=60

# Intervalo para mostrar estadísticas
#STATS_INTERVAL=10

# Variable para definir cada cuánto se consulta la colección raw_messages
POLL_INTERVAL=5

# Nivel de logging
LOG_LEVEL=DEBUG

# ----------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------
# Intervalo para imprimir estadísticas (segundos)
STATS_INTERVAL=10


# ----------------------------------------------------------
# Kafka - Configuración de infraestructura
# ----------------------------------------------------------
# Puerto de Zookeeper
ZOOKEEPER_PORT=22181

# Puerto de Kafka (interno para servicios Docker)
KAFKA_PORT=29092


# Topic principal del proyecto
KAFKA_TOPIC=probando
